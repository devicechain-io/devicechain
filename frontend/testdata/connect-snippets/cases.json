  {
    "name": "shell metacharacters stay quoted",
    "input": {
      "tenant": "acme",
      "deviceToken": "odd-1",
      "credential": {
        "credentialType": "ACCESS_TOKEN",
        "credentialId": "tok-odd"
      },
      "metrics": [
        {
          "metricKey": "it's $HOME",
          "dataType": "DOUBLE"
        }
      ]
    },
    "mqtt": "mosquitto_pub \\\n  --cafile instance-ca.crt \\\n  -h '<mqtt-host>' -p 1883 \\\n  -i '<instance-id>:acme:odd-1' \\\n  -u 'acme:tok-odd' \\\n  -t '<instance-id>/acme/devices/odd-1/events' \\\n  -m '{\"device\":\"odd-1\",\"eventType\":\"Measurement\",\"payload\":{\"entries\":[{\"measurements\":{\"it'\\''s $HOME\":\"21.5\"}}]}}'",
    "http": "curl -i -X POST 'http://<ingest-host>:8081/<instance-id>/acme/events' \\\n  -H 'Content-Type: application/json' \\\n  -d '{\"device\":\"odd-1\",\"eventType\":\"Measurement\",\"credentialType\":\"ACCESS_TOKEN\",\"credentialId\":\"tok-odd\",\"payload\":{\"entries\":[{\"measurements\":{\"it'\\''s $HOME\":\"21.5\"}}]}}'"
  }
]
