            "uid": "${datasource}"
          },
          "expr": "sum(rate(devicechain_commanddelivery_command_delivery_claims_stranded_total{namespace=\"$namespace\"}[5m]))",
          "legendFormat": "__auto"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.0001
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
