    },
    {
      "producer": "sitepulse",
      "ruleToken": "sp-rule-tyre-low",
      "profileToken": "sp-equipment-profile",
      "enabled": true,
      "alarmSeverityWire": "MAJOR",
      "definition": "{\"actions\":[{\"raiseAlarm\":{\"alarmKey\":\"tyre-pressure-low\"},\"type\":\"raiseAlarm\"}],\"name\":\"Site Pulse low tyre pressure\",\"severity\":\"major\",\"type\":\"threshold\",\"when\":{\"metric\":\"tyre_pressure_kpa\",\"op\":\"lt\",\"threshold\":600}}"
    },
    {
      "producer": "towerpulse",
      "ruleToken": "tp-rule-chiller-silent",
      "profileToken": "tp-chiller-profile",
      "enabled": true,
      "alarmSeverityWire": "CRITICAL",
      "definition": "{\"actions\":[{\"raiseAlarm\":{\"alarmKey\":\"chiller-silent\"},\"type\":\"raiseAlarm\"}],\"name\":\"Towerpulse chiller silent\",\"severity\":\"critical\",\"timeout\":\"2m0s\",\"type\":\"absence\",\"when\":{}}"
    },
    {
