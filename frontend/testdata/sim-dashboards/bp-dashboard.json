{
  "canvas": {
    "breakpoints": {
      "base": 0
    },
    "grid": {
      "columns": 12,
      "gutter": 8,
      "minCellSize": 56,
      "padding": 0
    },
    "sizing": "fill"
  },
  "schemaVersion": 3,
  "slots": {
    "building": {
      "defaultBinding": {
        "anchor": {
          "relationship": "assigned",
          "targetToken": "bp-bldg-01",
          "targetType": "area"
        },
        "kind": "anchor"
      },
      "label": "Building",
      "type": "anchor"
    },
    "selectedThermostat": {
      "defaultBinding": {
        "deviceToken": "bp-therm-001",
        "kind": "device"
      },
      "label": "Thermostat",
      "scope": {
        "parent": "building",
        "strategy": "manual"
      },
      "type": "device"
    }
  },
  "title": "Building Pulse",
  "widgets": [
    {
      "id": "w-building-select",
      "layout": {
        "base": {
          "col": 0,
          "cols": 6,
          "mode": "grid",
          "row": 0,
          "rows": 1
        }
      },
      "options": {
        "selectionTarget": "building",
        "title": "Building"
      },
      "type": "entity-selector"
    },
    {
      "id": "w-thermostat-select",
      "layout": {
        "base": {
          "col": 6,
          "cols": 6,
          "mode": "grid",
          "row": 0,
          "rows": 1
        }
      },
      "options": {
        "selectionTarget": "selectedThermostat",
        "title": "Thermostat"
      },
      "type": "entity-selector"
    },
    {
      "datasource": {
        "kind": "slot",
        "measurements": [
          "temperature"
        ],
        "slot": "selectedThermostat"
      },
      "id": "w-chart",
      "layout": {
        "base": {
          "col": 0,
          "cols": 7,
          "mode": "grid",
          "row": 1,
          "rows": 4
        }
      },
      "options": {
        "title": "Temperature"
      },
      "type": "timeseries-chart"
    },
    {
      "datasource": {
        "kind": "slot",
        "measurements": [],
        "slot": "selectedThermostat"
      },
      "id": "w-table",
      "layout": {
        "base": {
          "col": 7,
          "cols": 5,
          "mode": "grid",
          "row": 1,
          "rows": 4
        }
      },
      "options": {
        "flashOnChange": true,
        "precision": 1,
        "title": "Latest values"
      },
      "type": "table"
    },
    {
      "datasource": {
        "kind": "slot",
        "measurements": [],
        "slot": "building"
      },
      "id": "w-alarms",
      "layout": {
        "base": {
          "col": 0,
          "cols": 12,
          "mode": "grid",
          "row": 5,
          "rows": 3
        }
      },
      "options": {
        "flashOnChange": true,
        "maxRows": 50,
        "precision": 1,
        "selectionTarget": "selectedThermostat",
        "title": "Alarms"
      },
      "type": "alarm-table"
    }
  ]
}
