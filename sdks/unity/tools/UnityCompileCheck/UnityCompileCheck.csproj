<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Tier-1 reference-assembly compile check (no Unity Editor, no license, no GUI): compile the Unity
    package's Runtime + Sample sources against real UnityEngine reference assemblies to catch wrong-API
    calls and #if UNITY_WEBGL branch typos. It does NOT run — that's the Editor/WebGL job (game-ci in
    CI, a browser vs a live cluster for the final smoke). Build BOTH configs to check both platform
    branches:
      dotnet build -c Desktop   # the #else (ClientWebSocket) branch
      dotnet build -c WebGL     # the UNITY_WEBGL P/Invoke branch
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Configurations>Desktop;WebGL</Configurations>
    <!-- Reference assemblies only; never emit a usable binary. -->
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'WebGL'">
    <DefineConstants>$(DefineConstants);UNITY_WEBGL</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="UnityEngine.Modules" Version="2021.3.33" Condition="'$(UnityManagedDir)' == ''" />
    <ProjectReference Include="../../../csharp/src/DeviceChain.Sdk/DeviceChain.Sdk.csproj" />
  </ItemGroup>

  <!-- Optional local URP 17.5 check against an already imported project, without launching the Editor.
       Defaults retain the portable reference-package gate. No installed assemblies are copied or shipped. -->
  <PropertyGroup Condition="'$(UnityManagedDir)' != ''">
    <DefineConstants>$(DefineConstants);UNITY_6000_0_OR_NEWER</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(UnityManagedDir)' != ''">
    <Reference Include="$(UnityManagedDir)/UnityEngine/UnityEngine*.dll" Exclude="$(UnityManagedDir)/UnityEngine/UnityEngine.dll" />
    <Reference Include="$(HarborUrpAssembliesDir)/Unity.RenderPipelines.Core.Runtime.dll" />
    <Reference Include="$(HarborUrpAssembliesDir)/Unity.RenderPipelines.Universal.Runtime.dll" />
  </ItemGroup>

  <Target Name="UseInstalledUnityReferences" AfterTargets="ResolveLockFileReferences" Condition="'$(UnityManagedDir)' != ''">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="'%(Reference.NuGetPackageId)' == 'UnityEngine.Modules'" />
    </ItemGroup>
  </Target>
  <ItemGroup Condition="'$(CompileHarborEditor)' == 'true'">
    <Reference Include="$(UnityManagedDir)/UnityEditor.dll" />
    <Reference Include="$(UnityManagedDir)/UnityEngine/UnityEditor*.dll" />
    <Compile Include="../../../../demos/harborpulse-unity/Assets/Harborpulse/Scripts/Editor/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../../io.devicechain.sdk/Runtime/**/*.cs" />
    <Compile Include="../../io.devicechain.sdk/Samples~/**/*.cs" />
    <!-- The shared demo platform package builds on this SDK (per-device MQTT sessions, event publishing), so its
         engine-bound assemblies are compiled here too, against the same reference assemblies. -->
    <Compile Include="../../../../demos/shared/io.devicechain.demo-platform/Runtime/**/*.cs" />
    <!-- Towerpulse's device plane sits on that package: its engine-free model and plane, and the engine-bound sessions and bootstrap. -->
    <Compile Include="../../../../demos/towerpulse-unity/Assets/Towerpulse/Scripts/Model/**/*.cs" />
    <Compile Include="../../../../demos/towerpulse-unity/Assets/Towerpulse/Scripts/Plane/**/*.cs" />
    <Compile Include="../../../../demos/towerpulse-unity/Assets/Towerpulse/Scripts/DevicePlane/**/*.cs" />
    <!-- The story layer (engine-free) and the two visuals components that need only the engine's own modules. The cards (StoryUi) and the composition
         root that owns them use the ugui package's Text and Image, which the reference assemblies above do not carry, so the Editor compiles those. -->
    <Compile Include="../../../../demos/towerpulse-unity/Assets/Towerpulse/Scripts/Story/**/*.cs" />
    <Compile Include="../../../../demos/towerpulse-unity/Assets/Towerpulse/Scripts/Recording/**/*.cs" />
    <Compile Include="../../../../demos/towerpulse-unity/Assets/Towerpulse/Scripts/Visuals/CampusView.cs" />
    <Compile Include="../../../../demos/towerpulse-unity/Assets/Towerpulse/Scripts/Visuals/ShotDirector.cs" />
    <!-- The shared demo HUD's engine-free model (the caption box, chain card and alarm pin rules) is compiled here because Harborpulse's
         model builds on it. Its uGUI views (Runtime/Ugui) need the ugui package, like the two HUD renderers named below.
         Harborpulse: the engine-free model, the read-only platform link (shared observer over the SDK), and the visuals, which use only the
         engine's own modules (meshes, lights, IMGUI). Its URP shaders and the Editor scene builder need the Editor. -->
    <Compile Include="../../../../demos/shared/io.devicechain.demo-hud/Runtime/Model/**/*.cs" />
    <Compile Include="../../../../demos/harborpulse-unity/Assets/Harborpulse/Scripts/Model/**/*.cs" />
    <Compile Include="../../../../demos/harborpulse-unity/Assets/Harborpulse/Scripts/Live/**/*.cs" />
    <Compile Include="../../../../demos/harborpulse-unity/Assets/Harborpulse/Scripts/Visuals/**/*.cs" />
    <!-- Harborpulse Scripts/Hud uses ugui Text/Image, like Towerpulse StoryUi above.
         The portable UnityEngine reference assemblies do not carry ugui; the Editor
         compiles that thin renderer. Its logic in Model/Director/HudModel is checked here. -->
  </ItemGroup>

</Project>
