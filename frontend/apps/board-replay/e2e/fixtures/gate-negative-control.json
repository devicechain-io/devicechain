{
  "schemaVersion": 2,
  "title": "Readability gate negative control",
  "canvas": {
    "breakpoints": {
      "base": 0
    },
    "grid": {
      "columns": 24,
      "minCellSize": 24,
      "gutter": 8,
      "padding": 0
    },
    "sizing": "fill"
  },
  "widgets": [
    {
      "id": "nc-clean",
      "type": "label",
      "layout": {
        "base": {
          "mode": "grid",
          "col": 0,
          "row": 0,
          "cols": 8,
          "rows": 2
        }
      },
      "options": {
        "align": "left",
        "fontSize": 14,
        "text": "Fits"
      }
    },
    {
      "id": "nc-overflowing-card",
      "type": "latest-card",
      "layout": {
        "base": {
          "mode": "grid",
          "col": 8,
          "row": 0,
          "cols": 1,
          "rows": 4
        }
      },
      "datasource": {
        "kind": "device",
        "deviceToken": "gate-device-01",
        "measurements": [
          "value"
        ]
      },
      "options": {
        "measurement": "value",
        "precision": 4,
        "title": "A card title far too long for a card this small",
        "unit": "kPa"
      }
    },
    {
      "id": "nc-long-title",
      "type": "latest-card",
      "layout": {
        "base": {
          "mode": "grid",
          "col": 0,
          "row": 2,
          "cols": 6,
          "rows": 4
        }
      },
      "datasource": {
        "kind": "device",
        "deviceToken": "gate-device-01",
        "measurements": [
          "value"
        ]
      },
      "options": {
        "measurement": "value",
        "title": "A frame title far too long to fit on one line of a card this wide, at either gated width",
        "unit": "kPa"
      }
    },
    {
      "id": "nc-overflowing-label",
      "type": "label",
      "layout": {
        "base": {
          "mode": "grid",
          "col": 10,
          "row": 0,
          "cols": 2,
          "rows": 1
        }
      },
      "options": {
        "align": "left",
        "fontSize": 32,
        "text": "Unbreakablelabeltextthatcannotfit"
      }
    },
    {
      "id": "nc-level-overflow",
      "type": "linear-gauge",
      "layout": {
        "base": {
          "mode": "grid",
          "col": 0,
          "row": 6,
          "cols": 1,
          "rows": 4
        }
      },
      "datasource": {
        "kind": "device",
        "deviceToken": "gate-device-01",
        "measurements": [
          "value"
        ]
      },
      "options": {
        "max": 1,
        "measurement": "value",
        "min": 0,
        "orientation": "vertical",
        "precision": 4,
        "title": "Level",
        "unit": "kPa"
      }
    },
    {
      "id": "nc-gauge-overflow",
      "type": "gauge",
      "layout": {
        "base": {
          "mode": "grid",
          "col": 2,
          "row": 6,
          "cols": 1,
          "rows": 4
        }
      },
      "datasource": {
        "kind": "device",
        "deviceToken": "gate-device-01",
        "measurements": [
          "value"
        ]
      },
      "options": {
        "max": 1000,
        "measurement": "value",
        "min": 0,
        "precision": 4,
        "title": "Gauge",
        "unit": "kPa"
      }
    },
    {
      "id": "nc-overlap-a",
      "type": "label",
      "layout": {
        "base": {
          "mode": "grid",
          "col": 12,
          "row": 0,
          "cols": 6,
          "rows": 2
        }
      },
      "options": {
        "align": "left",
        "fontSize": 14,
        "text": "A"
      }
    },
    {
      "id": "nc-overlap-host",
      "type": "label",
      "layout": {
        "base": {
          "mode": "grid",
          "col": 18,
          "row": 0,
          "cols": 6,
          "rows": 2
        }
      },
      "options": {
        "align": "left",
        "fontSize": 14,
        "text": "Host"
      }
    },
    {
      "id": "nc-overlap-b",
      "type": "label",
      "layout": {
        "base": {
          "mode": "relative",
          "host": "nc-overlap-host",
          "anchor": "left",
          "self": "right",
          "size": {
            "cols": 4,
            "rows": 2
          }
        }
      },
      "options": {
        "align": "left",
        "fontSize": 14,
        "text": "B"
      }
    }
  ]
}
