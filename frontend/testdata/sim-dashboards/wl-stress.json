{
  "canvas": {
    "breakpoints": {
      "base": 0
    },
    "grid": {
      "columns": 12,
      "gutter": 8,
      "minCellSize": 56,
      "padding": 0
    },
    "sizing": "fill"
  },
  "schemaVersion": 3,
  "slots": {
    "edgeExtremes": {
      "defaultBinding": {
        "deviceToken": "wl-edge-01",
        "kind": "device"
      },
      "label": "Extremes sensor",
      "type": "device"
    },
    "edgePartial": {
      "defaultBinding": {
        "deviceToken": "wl-edge-02",
        "kind": "device"
      },
      "label": "Partial reporter",
      "type": "device"
    },
    "edgeSilent": {
      "defaultBinding": {
        "deviceToken": "wl-edge-03",
        "kind": "device"
      },
      "label": "Silent sensor",
      "type": "device"
    }
  },
  "title": "Widget Lab — Stress",
  "widgets": [
    {
      "id": "wl-stress-title",
      "layout": {
        "base": {
          "col": 0,
          "cols": 12,
          "mode": "grid",
          "row": 0,
          "rows": 1
        }
      },
      "options": {
        "align": "left",
        "fontSize": 16,
        "text": "Pathological data, meant to look wrong"
      },
      "type": "label"
    },
    {
      "datasource": {
        "kind": "slot",
        "measurements": [
          "temperature"
        ],
        "slot": "edgeExtremes"
      },
      "id": "wl-stress-chart",
      "layout": {
        "base": {
          "col": 0,
          "cols": 7,
          "mode": "grid",
          "row": 1,
          "rows": 5
        }
      },
      "options": {
        "title": "Spikes and out-of-range",
        "windowSeconds": 900
      },
      "type": "timeseries-chart"
    },
    {
      "datasource": {
        "kind": "slot",
        "measurements": [
          "temperature"
        ],
        "slot": "edgeExtremes"
      },
      "id": "wl-stress-gauge",
      "layout": {
        "base": {
          "col": 7,
          "cols": 5,
          "mode": "grid",
          "row": 1,
          "rows": 3
        }
      },
      "options": {
        "flashOnChange": true,
        "max": 35,
        "measurement": "temperature",
        "min": 15,
        "title": "Off the scale",
        "unit": "C"
      },
      "type": "gauge"
    },
    {
      "datasource": {
        "kind": "slot",
        "measurements": [
          "temperature"
        ],
        "slot": "edgeExtremes"
      },
      "id": "wl-stress-card",
      "layout": {
        "base": {
          "col": 7,
          "cols": 5,
          "mode": "grid",
          "row": 4,
          "rows": 2
        }
      },
      "options": {
        "measurement": "temperature",
        "title": "Unrounded",
        "unit": "C"
      },
      "type": "latest-card"
    },
    {
      "datasource": {
        "kind": "slot",
        "measurements": [],
        "slot": "edgePartial"
      },
      "id": "wl-stress-table",
      "layout": {
        "base": {
          "col": 0,
          "cols": 6,
          "mode": "grid",
          "row": 6,
          "rows": 3
        }
      },
      "options": {
        "flashOnChange": true,
        "precision": 2,
        "title": "Partial reports"
      },
      "type": "table"
    },
    {
      "datasource": {
        "kind": "slot",
        "measurements": [
          "temperature"
        ],
        "slot": "edgeSilent"
      },
      "id": "wl-stress-silence",
      "layout": {
        "base": {
          "col": 6,
          "cols": 6,
          "mode": "grid",
          "row": 6,
          "rows": 3
        }
      },
      "options": {
        "title": "Goes silent",
        "windowSeconds": 900
      },
      "type": "timeseries-chart"
    },
    {
      "id": "wl-stress-label",
      "layout": {
        "base": {
          "col": 0,
          "cols": 6,
          "mode": "grid",
          "row": 9,
          "rows": 2
        }
      },
      "options": {
        "align": "left",
        "fontSize": 18,
        "text": "Pneumonoultramicroscopicsilicovolcanoconiosisantidisestablishmentarianismfloccinaucinihilipilification"
      },
      "type": "label"
    },
    {
      "id": "wl-stress-image",
      "layout": {
        "base": {
          "col": 6,
          "cols": 6,
          "mode": "grid",
          "row": 9,
          "rows": 2
        }
      },
      "options": {
        "alt": "An image that cannot decode",
        "fit": "cover",
        "title": "Broken image",
        "url": "data:image/png;base64,this-is-not-base64"
      },
      "type": "image"
    },
    {
      "datasource": {
        "kind": "slot",
        "measurements": [
          "temperature"
        ],
        "slot": "edgeExtremes"
      },
      "id": "wl-stress-linear",
      "layout": {
        "base": {
          "col": 0,
          "cols": 6,
          "mode": "grid",
          "row": 11,
          "rows": 3
        }
      },
      "options": {
        "max": 35,
        "measurement": "temperature",
        "min": 15,
        "precision": 1,
        "style": "bar",
        "thresholds": [
          {
            "level": "normal",
            "value": 15
          },
          {
            "level": "warning",
            "value": 28
          },
          {
            "level": "critical",
            "value": 32
          }
        ],
        "title": "Off the scale (bar)",
        "unit": "C"
      },
      "type": "linear-gauge"
    },
    {
      "datasource": {
        "kind": "slot",
        "measurements": [
          "temperature"
        ],
        "slot": "edgeExtremes"
      },
      "id": "wl-stress-level",
      "layout": {
        "base": {
          "col": 6,
          "cols": 3,
          "mode": "grid",
          "row": 11,
          "rows": 4
        }
      },
      "options": {
        "max": 35,
        "measurement": "temperature",
        "min": 15,
        "precision": 0,
        "readout": "value",
        "thresholds": [
          {
            "level": "normal",
            "value": 15
          },
          {
            "level": "warning",
            "value": 28
          },
          {
            "level": "critical",
            "value": 32
          }
        ],
        "title": "Off the scale (tank)",
        "unit": "C"
      },
      "type": "level-gauge"
    },
    {
      "datasource": {
        "kind": "slot",
        "measurements": [
          "temperature"
        ],
        "slot": "edgeExtremes"
      },
      "id": "wl-stress-compass",
      "layout": {
        "base": {
          "col": 0,
          "cols": 4,
          "mode": "grid",
          "row": 15,
          "rows": 4
        }
      },
      "options": {
        "measurement": "temperature",
        "precision": 0,
        "title": "Headings that fold"
      },
      "type": "compass"
    },
    {
      "datasource": {
        "kind": "slot",
        "measurements": [
          "temperature"
        ],
        "slot": "edgeExtremes"
      },
      "id": "wl-stress-ring",
      "layout": {
        "base": {
          "col": 4,
          "cols": 3,
          "mode": "grid",
          "row": 15,
          "rows": 3
        }
      },
      "options": {
        "max": 35,
        "measurement": "temperature",
        "min": 15,
        "precision": 0,
        "readout": "value",
        "thresholds": [
          {
            "level": "normal",
            "value": 15
          },
          {
            "level": "warning",
            "value": 28
          },
          {
            "level": "critical",
            "value": 32
          }
        ],
        "title": "Off the scale (ring)",
        "unit": "C"
      },
      "type": "progress-ring"
    }
  ]
}
