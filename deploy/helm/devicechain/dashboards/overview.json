    {
      "id": 222,
      "type": "stat",
      "title": "Areas with no pod available",
      "description": "How many areas of this instance, and the console, want at least one pod and have none available. An area whose pods are all gone stops reporting, so it also vanishes from the readiness count and the scrape count above; this is the panel that still shows it. Zero is healthy. A non-zero value that stays means that area is down: describe its pods. An area you scaled to zero by hand wants no pods and is not counted here: the Areas scaled to 0 tile below shows it.",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 27
      },
