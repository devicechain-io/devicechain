{
  "name": "@devicechain/host-widgets",
  "private": true,
  "version": "0.0.0-dev",
  "description": "The widget composition shared by the console, the /dash viewer and the board-replay player: the built-in widgets plus the extension packages this deployment installs.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./fixtures/acme-tank": "./fixtures/acme-tank/index.tsx"
  },
  "scripts": {
    "pretypecheck": "node ../../scripts/build-packages.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"fixtures/**/*.{ts,tsx}\"",
    "pretest": "node ../../scripts/build-packages.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@devicechain/dashboards": "0.0.0-dev",
    "@devicechain/widget-sdk": "0.0.0-dev",
    "@devicechain/widgets": "0.0.0-dev"
  },
  "devDependencies": {
    "@babel/core": "^8.0.9",
    "@babel/eslint-parser": "^8.0.7",
    "@babel/preset-react": "^8.0.1",
    "@babel/preset-typescript": "^8.0.7",
    "@types/react": "^19.3.0",
    "eslint": "^10.13.0",
    "eslint-plugin-i18next": "^6.1.5",
    "react": "^19.3.1",
    "typescript": "~7.0.2",
    "vitest": "^5.0.5"
  }
}
