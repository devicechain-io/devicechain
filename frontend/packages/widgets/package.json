{
  "name": "@devicechain/widgets",
  "version": "0.0.0-dev",
  "description": "DeviceChain's built-in dashboard widgets across six channels — telemetry (time-series chart + gauge over Apache ECharts, latest card, table, and lazily loaded level, indicator and radial widgets: linear and level gauges, battery, status light, signal bars, compass, progress ring), static (label, image; no data), alarm (table, count, severity breakdown), control (command button), selection (entity selector), and location (map over MapLibre GL, lazily loaded, tile source supplied by the host app) — plus the renderer that lays them out. Each is a registration built on @devicechain/widget-sdk. Themed via CSS custom properties, no Tailwind leakage.",
  "keywords": [
    "devicechain",
    "iot",
    "dashboard",
    "widgets",
    "react",
    "echarts",
    "maplibre"
  ],
  "license": "Apache-2.0",
  "homepage": "https://devicechain.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devicechain-io/devicechain.git",
    "directory": "frontend/packages/widgets"
  },
  "bugs": {
    "url": "https://github.com/devicechain-io/devicechain/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./host-context": {
      "types": "./dist/host-context.d.ts",
      "import": "./dist/host-context.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "./dist/vite.js"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node ../../scripts/build-package.mjs",
    "typecheck": "tsc --noEmit",
    "pretest": "node ../../scripts/build-packages.mjs",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@devicechain/client": "0.0.0-dev",
    "@devicechain/dashboards": "0.0.0-dev",
    "@devicechain/widget-sdk": "0.0.0-dev",
    "echarts": "^6.0.0",
    "maplibre-gl": "^6.13.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@devicechain/client": "0.0.0-dev",
    "@devicechain/dashboards": "0.0.0-dev",
    "@devicechain/widget-sdk": "0.0.0-dev",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "echarts": "^6.0.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "maplibre-gl": "^6.15.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "~7.0.2",
    "vitest": "^5.0.5"
  }
}
