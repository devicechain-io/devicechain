  The test kit consumers use in their own tests, compiled from the package's Testing/ folder.
  It has no NUnit dependency, so it could never pull a test framework into a player build.
-->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.1;net8.0</TargetFrameworks>
    <RootNamespace>DeviceChain.Sim.Traffic.Testing</RootNamespace>
    <AssemblyName>DeviceChain.Sim.Traffic.Testing</AssemblyName>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <!-- Pinned on purpose. IsAotCompatible/PublishAot make the SDK add Microsoft.NET.ILLink.Tasks
       implicitly, at the version bundled with whichever .NET SDK patch is installed. That floats
       with the runner image, so a locked restore fails NU1004 the day the image moves a patch.
       Declared here, the version is ours and moves only when this line (and the lock) does. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="Microsoft.NET.ILLink.Tasks" Version="8.0.31" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../DeviceChain.Sim.Traffic/DeviceChain.Sim.Traffic.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../../Testing/**/*.cs" />
  </ItemGroup>

</Project>
