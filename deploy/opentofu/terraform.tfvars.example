#
# Copy to terraform.tfvars (gitignored) and adjust. The defaults target a local
# single-node cluster; override credentials and pin chart/image versions for any
# real deploy.

# kubeconfig_path    = "~/.kube/config"
# kubeconfig_context = "kind-devicechain"

# namespace        = "dc-system"
# create_namespace = true

# Pin to a tested chart/image version for reproducible deploys.
# nats_chart_version = "1.2.2"
# timescale_image    = "timescale/timescaledb:2.17.2-pg16"

# Change these for anything beyond local dev (or use a pre-created Secret).
# postgres_password  = "CHANGE-ME"
# timescale_password = "CHANGE-ME"

# Data durability (methodology §11). Empty uses the cluster default StorageClass,
# whose reclaimPolicy is usually Delete — so PVC/PV deletion destroys the data.
# FOR PRODUCTION point these at a StorageClass whose reclaimPolicy is Retain, so
# the underlying volume (and its data) survives PVC/PV deletion and a redeploy
# re-attaches it. (The StatefulSets also Retain PVCs on delete/scale and carry a
# prevent_destroy guard — see README "Data durability".)
# postgres_storage_class  = "retain-ssd"
# timescale_storage_class = "retain-ssd"

# Single-node by default; flip on for the ADR-020 HA topology (when implemented).
# ha = false

# Ingress + TLS. Disable either if the cluster already has it; pin chart versions.
# enable_ingress_nginx       = true
# enable_cert_manager        = true
# ingress_class              = "nginx"
# ingress_nginx_chart_version = "4.11.3"
# cert_manager_chart_version  = "v1.16.2"

# CloudNativePG — the operator that will own both database stores (ADR-020 A2), plus
# the Barman Cloud plugin that provides WAL archiving and point-in-time recovery.
# Default-on for EVERY install, HA or not: backup is not an HA feature. Both charts
# require Kubernetes >= 1.29. Versions are pinned by default (see variables.tf).
#
# enable_database_backups REQUIRES cert-manager to be present — the plugin's chart
# renders an Issuer and two Certificates, so with no cert-manager CRDs the apply
# fails outright. Setting enable_cert_manager=false because the cluster ALREADY has
# cert-manager is fine and backups keep working; setting it false because there is no
# cert-manager at all means you must set enable_database_backups=false as well.
#
# Set enable_cnpg=false if the cluster already runs CloudNativePG — Helm cannot adopt
# objects the upstream `kubectl apply` manifest created.
# enable_cnpg               = true
# enable_database_backups   = true
# cnpg_namespace            = "cnpg-system"
# cnpg_chart_version        = "0.29.0"
# cnpg_plugin_chart_version = "0.7.0"

# Observability (kube-prometheus-stack — Prometheus/Grafana/Alertmanager). Default-on.
# Set enable_monitoring=false if the cluster already has the Prometheus Operator.
# Local/kind should set monitoring_slim=true (emptyDir TSDB, smaller requests).
# enable_monitoring                 = true
# monitoring_slim                   = false
# monitoring_chart_version          = "65.1.1"
# monitoring_grafana_admin_password = "CHANGE-ME"
# monitoring_prometheus_retention   = "15d"
# monitoring_prometheus_storage     = "20Gi"
# monitoring_storage_class          = "retain-ssd"
