{
  "name": "@devicechain/brand",
  "version": "0.0.0-dev",
  "description": "Canonical DeviceChain brand tokens, plus the generated per-consumer stylesheets.",
  "keywords": [
    "devicechain",
    "design-tokens",
    "css",
    "theme"
  ],
  "license": "Apache-2.0",
  "homepage": "https://devicechain.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devicechain-io/devicechain.git",
    "directory": "frontend/packages/brand"
  },
  "bugs": {
    "url": "https://github.com/devicechain-io/devicechain/issues"
  },
  "type": "module",
  "sideEffects": [
    "./css/*.css"
  ],
  "exports": {
    "./tokens.json": "./tokens.json",
    "./tokens": "./tokens.generated.json",
    "./css/brand.css": "./css/brand.css",
    "./css/shadcn.css": "./css/shadcn.css",
    "./css/infima.css": "./css/infima.css"
  },
  "files": [
    "css",
    "tokens.json",
    "tokens.generated.json",
    "tools",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "generate": "node tools/generate.mjs",
    "check:generated": "node tools/generate.mjs --check",
    "verify": "node tools/verify.mjs",
    "build": "node tools/generate.mjs --check"
  },
  "publishConfig": {
    "access": "public"
  }
}
