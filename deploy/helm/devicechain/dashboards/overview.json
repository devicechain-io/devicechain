            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "count(kube_deployment_spec_replicas{namespace=\"$namespace\", deployment!~\".+-box\"} > 0 unless on (namespace, deployment) kube_deployment_status_replicas_available{namespace=\"$namespace\"} > 0) or vector(0)",
          "instant": true
