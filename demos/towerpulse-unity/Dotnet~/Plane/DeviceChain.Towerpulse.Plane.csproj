<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.1;net8.0</TargetFrameworks>
    <RootNamespace>DeviceChain.Towerpulse.Plane</RootNamespace>
    <AssemblyName>DeviceChain.Towerpulse.Plane</AssemblyName>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Model/DeviceChain.Towerpulse.Model.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../../Assets/Towerpulse/Scripts/Plane/**/*.cs" />
  </ItemGroup>

</Project>
