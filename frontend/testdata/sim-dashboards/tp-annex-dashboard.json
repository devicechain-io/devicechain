{
  "canvas": {
    "breakpoints": {
      "base": 0
    },
    "grid": {
      "columns": 12,
      "gutter": 8,
      "minCellSize": 56,
      "padding": 0
    },
    "sizing": "fill"
  },
  "schemaVersion": 3,
  "slots": {
    "annex": {
      "defaultBinding": {
        "anchor": {
          "relationship": "assigned",
          "targetToken": "tp-halden",
          "targetType": "customer"
        },
        "kind": "anchor"
      },
      "label": "Annex",
      "type": "anchor"
    },
    "chillerAnnex": {
      "defaultBinding": {
        "deviceToken": "tp-chiller-annex",
        "kind": "device"
      },
      "label": "Annex chiller",
      "type": "device"
    },
    "meterAnnex": {
      "defaultBinding": {
        "deviceToken": "tp-meter-annex",
        "kind": "device"
      },
      "label": "Annex meter",
      "type": "device"
    },
    "selectedZone": {
      "defaultBinding": {
        "deviceToken": "tp-vav-annex-f1-north",
        "kind": "device"
      },
      "label": "Device",
      "scope": {
        "parent": "annex",
        "strategy": "manual"
      },
      "type": "device"
    }
  },
  "timeRange": {
    "defaultSeconds": 3600
  },
  "title": "Towerpulse annex",
  "widgets": [
    {
      "id": "tp-zone-select",
      "layout": {
        "base": {
          "col": 0,
          "cols": 12,
          "mode": "grid",
          "row": 0,
          "rows": 1
        }
      },
      "options": {
        "selectionTarget": "selectedZone",
        "title": "Device"
      },
      "type": "entity-selector"
    },
    {
      "datasource": {
        "kind": "slot",
        "measurements": [],
        "slot": "annex"
      },
      "id": "tp-alarm-severity",
      "layout": {
        "base": {
          "col": 0,
          "cols": 3,
          "mode": "grid",
          "row": 1,
          "rows": 3
        }
      },
      "options": {
        "state": "ACTIVE",
        "title": "Active alarms by severity"
      },
      "type": "alarm-severity"
    },
    {
      "datasource": {
        "kind": "slot",
        "measurements": [],
        "slot": "annex"
      },
      "id": "tp-online",
      "layout": {
        "base": {
          "col": 3,
          "cols": 3,
          "mode": "grid",
          "row": 1,
          "rows": 3
        }
      },
      "options": {
        "title": "Devices online"
      },
      "type": "online-doughnut"
    },
    {
      "datasource": {
        "kind": "slot",
        "measurements": [
          "kw"
        ],
        "slot": "meterAnnex"
      },
      "id": "tp-kw-annex",
      "layout": {
        "base": {
          "col": 6,
          "cols": 3,
          "mode": "grid",
          "row": 1,
          "rows": 3
        }
      },
      "options": {
        "measurement": "kw",
        "precision": 0,
        "sparkline": true,
        "stat": "last",
        "title": "Annex power",
        "unit": "kW"
      },
      "type": "stat-card"
    },
    {
      "datasource": {
        "kind": "slot",
        "measurements": [
          "kwh_per_m2"
        ],
        "slot": "meterAnnex"
      },
      "id": "tp-kwh-m2-annex",
      "layout": {
        "base": {
          "col": 9,
          "cols": 3,
          "mode": "grid",
          "row": 1,
          "rows": 3
        }
      },
      "options": {
        "measurement": "kwh_per_m2",
        "precision": 2,
        "stat": "last",
        "title": "Annex energy per m2",
        "unit": "kWh/m2"
      },
      "type": "stat-card"
    },
    {
      "datasource": {
        "kind": "slot",
        "measurements": [],
        "slot": "chillerAnnex"
      },
      "id": "tp-chiller-annex-status",
      "layout": {
        "base": {
          "col": 0,
          "cols": 4,
          "mode": "grid",
          "row": 4,
          "rows": 3
        }
      },
      "options": {
        "staleAfterSeconds": 120,
        "title": "Annex chiller status"
      },
      "type": "device-status"
    },
    {
      "datasource": {
        "kind": "slot",
        "measurements": [
          "temp_c"
        ],
        "slot": "selectedZone"
      },
      "id": "tp-zone-temp",
      "layout": {
        "base": {
          "col": 4,
          "cols": 4,
          "mode": "grid",
          "row": 4,
          "rows": 3
        }
      },
      "options": {
        "flashOnChange": true,
        "max": 34,
        "measurement": "temp_c",
        "min": 16,
        "thresholds": [
          {
            "level": "normal",
            "value": 16
          },
          {
            "level": "major",
            "value": 26
          }
        ],
        "title": "Temperature",
        "unit": "°C"
      },
      "type": "gauge"
    },
    {
      "datasource": {
        "kind": "slot",
        "measurements": [
          "co2_ppm"
        ],
        "slot": "selectedZone"
      },
      "id": "tp-zone-co2",
      "layout": {
        "base": {
          "col": 8,
          "cols": 4,
          "mode": "grid",
          "row": 4,
          "rows": 3
        }
      },
      "options": {
        "flashOnChange": true,
        "max": 1400,
        "measurement": "co2_ppm",
        "min": 400,
        "thresholds": [
          {
            "level": "normal",
            "value": 400
          },
          {
            "level": "minor",
            "value": 1000
          }
        ],
        "title": "CO2",
        "unit": "ppm"
      },
      "type": "gauge"
    },
    {
      "datasource": {
        "kind": "slot",
        "measurements": [
          "temp_c"
        ],
        "slot": "annex"
      },
      "id": "tp-floor-compare",
      "layout": {
        "base": {
          "col": 0,
          "cols": 7,
          "mode": "grid",
          "row": 7,
          "rows": 4
        }
      },
      "options": {
        "groupBy": "device",
        "markAlarms": true,
        "max": 32,
        "maxSeries": 6,
        "measurement": "temp_c",
        "min": 18,
        "thresholds": [
          {
            "level": "major",
            "value": 26
          }
        ],
        "title": "Zone temperatures",
        "unit": "°C"
      },
      "type": "timeseries-chart"
    },
    {
      "datasource": {
        "kind": "slot",
        "measurements": [
          "cop"
        ],
        "slot": "chillerAnnex"
      },
      "id": "tp-annex-cop",
      "layout": {
        "base": {
          "col": 7,
          "cols": 5,
          "mode": "grid",
          "row": 7,
          "rows": 4
        }
      },
      "options": {
        "precision": 2,
        "title": "Annex chiller COP"
      },
      "type": "timeseries-chart"
    },
    {
      "datasource": {
        "kind": "slot",
        "measurements": [],
        "slot": "annex"
      },
      "id": "tp-alarms",
      "layout": {
        "base": {
          "col": 0,
          "cols": 12,
          "mode": "grid",
          "row": 11,
          "rows": 4
        }
      },
      "options": {
        "deviceTypes": [
          {
            "token": "tp-vav-zone"
          },
          {
            "token": "tp-ahu"
          },
          {
            "token": "tp-chiller"
          },
          {
            "token": "tp-energy-meter"
          }
        ],
        "flashOnChange": true,
        "groupBy": "deviceType",
        "maxRows": 25,
        "precision": 1,
        "selectionTarget": "selectedZone",
        "state": "ACTIVE",
        "title": "Alarms"
      },
      "type": "alarm-table"
    },
    {
      "datasource": {
        "kind": "slot",
        "measurements": [],
        "slot": "meterAnnex"
      },
      "id": "tp-power-history",
      "layout": {
        "base": {
          "col": 0,
          "cols": 12,
          "mode": "grid",
          "row": 15,
          "rows": 5
        }
      },
      "options": {
        "columns": [
          {
            "label": "Power",
            "measurement": "kw",
            "precision": 1,
            "unit": "kW"
          },
          {
            "label": "Energy",
            "measurement": "kwh",
            "precision": 0,
            "unit": "kWh"
          },
          {
            "label": "Energy per m2",
            "measurement": "kwh_per_m2",
            "precision": 2,
            "unit": "kWh/m2"
          }
        ],
        "pageSize": 10,
        "title": "Annex power history"
      },
      "type": "history-table"
    }
  ]
}
