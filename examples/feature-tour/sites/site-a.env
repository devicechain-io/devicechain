#
# Site A: a cold-storage operator and its first customer. Every value the tour needs that is not
# the same on every site is here. Copy this file to make a site of your own.

# The platform side. Environment variables of the same names override these.
INSTANCE=tour                              # the dcctl instance name (namespace dci-<instance>)

# The tenant this site lives in, and the customer inside it.
TOUR_TENANT=tour-a
TOUR_TENANT_NAME="Cold chain A"
TOUR_OPERATOR_EMAIL=operator@coldchain-a.example   # this site's tenant administrator; the password is generated
TOUR_CUSTOMER=acme
TOUR_CUSTOMER_NAME="Acme Foods"
TOUR_CUSTOMER_EMAIL=ops@acme.example       # the customer user's sign-in; the password is generated

# Two cold rooms in one tenant. The first is assigned to the customer; the second is not, which is
# what lets the tour show that the customer sees one and the operator sees both.
TOUR_DEVICE_1=coldroom-a1
TOUR_DEVICE_2=coldroom-a2

# The rule and the simulated rooms: a room warms 1 degree per tick from START_C; above ALARM_ABOVE
# the rule raises an alarm and sends boost-cooling; the room then cools to TARGET_C.
TOUR_ALARM_ABOVE=8
TOUR_START_C=5
TOUR_TARGET_C=4
TOUR_TICK_SECONDS=4
