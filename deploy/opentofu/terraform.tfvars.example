#
# Copy to terraform.tfvars (gitignored) and adjust. The defaults target a local
# single-node cluster; override credentials and pin chart/image versions for any
# real deploy.

# kubeconfig_path    = "~/.kube/config"
# kubeconfig_context = "kind-devicechain"

# namespace        = "dc-system"
# create_namespace = true

# Pin to a tested chart/image version for reproducible deploys. nats_chart_version is
# ALREADY pinned in variables.tf and this is only how you would move it — read that
# variable's description first, because the module's behaviour depends on the chart
# and a bump is a deliberate act. An empty value is REFUSED (it used to install
# latest); so is a 1.x chart's worth of drift, whose values schema is entirely
# different from the one this module renders — that one is on you to notice.
# nats_chart_version = "2.14.4"
# The event store needs a CloudNativePG operand image carrying TimescaleDB; the default
# is the one we build and publish. A stock `timescale/timescaledb:` image will not work.
# timescale_image    = "ghcr.io/devicechain-io/postgresql-timescaledb:17.10-ts2.28.3-r1"

# Change these for anything beyond local dev (or use a pre-created Secret).
# postgres_password  = "CHANGE-ME"
# timescale_password = "CHANGE-ME"

# Data durability (methodology §11). Empty uses the cluster default StorageClass,
# whose reclaimPolicy is usually Delete — so PVC/PV deletion destroys the data.
# FOR PRODUCTION point these at a StorageClass whose reclaimPolicy is Retain, so
# the underlying volume (and its data) survives PVC/PV deletion and a redeploy
# re-attaches it. (The StatefulSets also Retain PVCs on delete/scale and carry a
# prevent_destroy guard — see README "Data durability".)
# postgres_storage_class  = "retain-ssd"
# timescale_storage_class = "retain-ssd"

# Single-node by default; flip on for the ADR-020 HA topology (when implemented).
# ha = false

# Ingress + TLS. Disable either if the cluster already has it.
#
# Both chart versions are ALREADY pinned in variables.tf and these lines are only how
# you would move them. Read each variable's description first — both modules depend on
# chart internals (ingress-nginx's snippet/risk-level gating, cert-manager's CRD-install
# value), so a bump is a deliberate act with something to re-verify. An empty value is
# REFUSED: it used to install latest, which made the version resolve at apply time and
# two bootstraps of this commit install different software.
# enable_ingress_nginx        = true
# enable_cert_manager         = true
# ingress_class               = "nginx"
# ingress_nginx_chart_version = "4.15.1"
# cert_manager_chart_version  = "v1.21.1"

# CloudNativePG — the operator that will own both database stores (ADR-020 A2), plus
# the Barman Cloud plugin that provides WAL archiving and point-in-time recovery.
# Default-on for EVERY install, HA or not: backup is not an HA feature. Both charts
# require Kubernetes >= 1.29. Versions are pinned by default (see variables.tf).
#
# enable_database_backups REQUIRES cert-manager to be present — the plugin's chart
# renders an Issuer and two Certificates, so with no cert-manager CRDs the apply
# fails outright. Setting enable_cert_manager=false because the cluster ALREADY has
# cert-manager is fine and backups keep working; setting it false because there is no
# cert-manager at all means you must set enable_database_backups=false as well.
#
# Set enable_cnpg=false if the cluster already runs CloudNativePG — Helm cannot adopt
# objects the upstream `kubectl apply` manifest created.
# enable_cnpg               = true
# enable_database_backups   = true
# cnpg_namespace            = "cnpg-system"
# cnpg_chart_version        = "0.29.0"
# cnpg_plugin_chart_version = "0.7.0"

# Where the backups actually land (ADR-020 A2.5, ADR-028).
#
# 🔴 "in-cluster" IS NOT OFF-SITE BACKUP. It stands up a single-replica MinIO in this
# cluster, which shares the cluster's failure domain — lose the cluster and the backups
# go with it. It buys point-in-time recovery from an operator error, a bad migration or
# a bad delete, and a restore drill that exercises the production code path. For real
# disaster recovery use "external" and point at storage outside the cluster.
#
# There is no value meaning "backups on, destination none": that state is a plugin with
# nowhere to write, which reads as protection and is not. Use
# enable_database_backups = false instead.
#
# Two stores get TWO BUCKETS, never one bucket with two prefixes — core data and event
# data are independent restore domains with independent retention.
#
# 🔴 backup_schedule takes SIX cron fields (the first is SECONDS), unlike a Kubernetes
# CronJob. A five-field entry is accepted by the API and never runs. Default = 03:00 daily.
# backup_destination                = "in-cluster"
# backup_bucket_rdb                 = "devicechain-rdb"
# backup_bucket_tsdb                = "devicechain-tsdb"
# backup_access_key                 = "devicechain"
# backup_secret_key                 = "CHANGE-ME"
# backup_schedule                   = "0 0 3 * * *"
# backup_retention                  = "30d"
# backup_object_store_storage       = "20Gi"
# backup_object_store_storage_class = ""
#
# For an external destination, set the endpoint too — it is REQUIRED there and REFUSED
# with "in-cluster" (the in-cluster endpoint is provisioned here, so an override would
# name one destination while archiving to another). An EMPTY endpoint is not "no
# endpoint" to barman-cloud: it is the default AWS S3 endpoint, and every archive
# attempt would fail against real AWS without stalling a single write.
# backup_destination   = "external"
# backup_endpoint_url  = "https://s3.eu-west-1.amazonaws.com"

# Observability (kube-prometheus-stack — Prometheus/Grafana/Alertmanager). Default-on.
# Set enable_monitoring=false if the cluster already has the Prometheus Operator.
# Local/kind should set monitoring_slim=true (emptyDir TSDB, smaller requests).
# enable_monitoring                 = true
# monitoring_slim                   = false
# monitoring_chart_version          = "65.1.1"
# monitoring_grafana_admin_password = "CHANGE-ME"
# monitoring_prometheus_retention   = "15d"
# monitoring_prometheus_storage     = "20Gi"
# monitoring_storage_class          = "retain-ssd"
