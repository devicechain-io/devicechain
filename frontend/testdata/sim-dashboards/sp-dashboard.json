{
  "canvas": {
    "breakpoints": {
      "base": 0
    },
    "grid": {
      "columns": 12,
      "gutter": 8,
      "minCellSize": 56,
      "padding": 0
    },
    "sizing": "fill"
  },
  "schemaVersion": 3,
  "slots": {
    "plant": {
      "defaultBinding": {
        "deviceToken": "sp-plant-01",
        "kind": "device"
      },
      "label": "Crusher plant",
      "type": "device"
    },
    "selectedMachine": {
      "defaultBinding": {
        "deviceToken": "sp-hauler-03",
        "kind": "device"
      },
      "label": "Machine",
      "scope": {
        "parent": "site",
        "strategy": "manual"
      },
      "type": "device"
    },
    "site": {
      "defaultBinding": {
        "anchor": {
          "relationship": "assigned",
          "targetToken": "acme-earthworks",
          "targetType": "customer"
        },
        "kind": "anchor"
      },
      "label": "Site",
      "type": "anchor"
    }
  },
  "timeRange": {
    "defaultSeconds": 3600
  },
  "title": "Site Pulse",
  "widgets": [
    {
      "datasource": {
        "kind": "slot",
        "measurements": [],
        "slot": "site"
      },
      "id": "sp-alarms-critical",
      "layout": {
        "base": {
          "col": 0,
          "cols": 2,
          "mode": "grid",
          "row": 0,
          "rows": 2
        }
      },
      "options": {
        "severity": "CRITICAL",
        "state": "ACTIVE",
        "title": "Critical alarms"
      },
      "type": "alarm-count"
    },
    {
      "datasource": {
        "kind": "slot",
        "measurements": [],
        "slot": "site"
      },
      "id": "sp-alarms-major",
      "layout": {
        "base": {
          "col": 2,
          "cols": 2,
          "mode": "grid",
          "row": 0,
          "rows": 2
        }
      },
      "options": {
        "severity": "MAJOR",
        "state": "ACTIVE",
        "title": "Major alarms"
      },
      "type": "alarm-count"
    },
    {
      "datasource": {
        "kind": "slot",
        "measurements": [
          "plant_running"
        ],
        "slot": "plant"
      },
      "id": "sp-plant-running",
      "layout": {
        "base": {
          "col": 4,
          "cols": 2,
          "mode": "grid",
          "row": 0,
          "rows": 2
        }
      },
      "options": {
        "measurement": "plant_running",
        "onAt": 1,
        "precision": 0,
        "title": "Crusher running"
      },
      "type": "status-light"
    },
    {
      "datasource": {
        "kind": "slot",
        "measurements": [
          "throughput_tph"
        ],
        "slot": "plant"
      },
      "id": "sp-plant-throughput-now",
      "layout": {
        "base": {
          "col": 0,
          "cols": 3,
          "mode": "grid",
          "row": 2,
          "rows": 3
        }
      },
      "options": {
        "measurement": "throughput_tph",
        "precision": 0,
        "sparkline": true,
        "stat": "last",
        "title": "Throughput now",
        "unit": "t/h"
      },
      "type": "stat-card"
    },
    {
      "datasource": {
        "kind": "slot",
        "measurements": [
          "throughput_tph"
        ],
        "slot": "plant"
      },
      "id": "sp-plant-throughput-avg",
      "layout": {
        "base": {
          "col": 3,
          "cols": 3,
          "mode": "grid",
          "row": 2,
          "rows": 3
        }
      },
      "options": {
        "measurement": "throughput_tph",
        "precision": 0,
        "stat": "avg",
        "title": "Avg throughput",
        "unit": "t/h"
      },
      "type": "stat-card"
    },
    {
      "datasource": {
        "kind": "slot",
        "measurements": [
          "throughput_tph"
        ],
        "slot": "plant"
      },
      "id": "sp-plant-throughput-max",
      "layout": {
        "base": {
          "col": 6,
          "cols": 3,
          "mode": "grid",
          "row": 0,
          "rows": 2
        }
      },
      "options": {
        "measurement": "throughput_tph",
        "precision": 0,
        "stat": "max",
        "title": "Peak throughput",
        "unit": "t/h"
      },
      "type": "stat-card"
    },
    {
      "datasource": {
        "kind": "slot",
        "measurements": [
          "fuel_pct"
        ],
        "slot": "site"
      },
      "id": "sp-low-fuel",
      "layout": {
        "base": {
          "col": 6,
          "cols": 3,
          "mode": "grid",
          "row": 2,
          "rows": 3
        }
      },
      "options": {
        "measurement": "fuel_pct",
        "show": "attention",
        "thresholds": [
          {
            "level": "major",
            "value": 0
          },
          {
            "level": "normal",
            "value": 15
          }
        ],
        "title": "Low fuel"
      },
      "type": "fleet-count"
    },
    {
      "datasource": {
        "kind": "slot",
        "measurements": [],
        "slot": "site"
      },
      "id": "sp-alarms",
      "layout": {
        "base": {
          "col": 0,
          "cols": 5,
          "mode": "grid",
          "row": 5,
          "rows": 3
        }
      },
      "options": {
        "deviceTypes": [
          {
            "token": "sp-hauler"
          },
          {
            "token": "sp-loader"
          },
          {
            "token": "sp-dozer"
          },
          {
            "token": "sp-crusher-plant"
          }
        ],
        "flashOnChange": true,
        "groupBy": "deviceType",
        "maxRows": 25,
        "precision": 1,
        "selectionTarget": "selectedMachine",
        "state": "ACTIVE",
        "title": "Active alarms"
      },
      "type": "alarm-table"
    },
    {
      "datasource": {
        "kind": "slot",
        "location": {
          "series": "latest"
        },
        "measurements": [],
        "slot": "site"
      },
      "id": "sp-map",
      "layout": {
        "base": {
          "col": 5,
          "cols": 4,
          "mode": "grid",
          "row": 5,
          "rows": 3
        }
      },
      "options": {
        "selectionTarget": "selectedMachine",
        "title": "Machine positions"
      },
      "type": "map"
    },
    {
      "id": "sp-machine-select",
      "layout": {
        "base": {
          "col": 9,
          "cols": 3,
          "mode": "grid",
          "row": 0,
          "rows": 1
        }
      },
      "options": {
        "selectionTarget": "selectedMachine",
        "title": "Machine"
      },
      "type": "entity-selector"
    },
    {
      "datasource": {
        "kind": "slot",
        "measurements": [
          "engine_temp_c"
        ],
        "slot": "selectedMachine"
      },
      "id": "sp-engine-temp",
      "layout": {
        "base": {
          "col": 9,
          "cols": 3,
          "mode": "grid",
          "row": 1,
          "rows": 4
        }
      },
      "options": {
        "max": 130,
        "measurement": "engine_temp_c",
        "min": 0,
        "precision": 1,
        "style": "bar",
        "thresholds": [
          {
            "level": "normal",
            "value": 0
          },
          {
            "level": "critical",
            "value": 105
          }
        ],
        "title": "Engine temp",
        "unit": "°C"
      },
      "type": "linear-gauge"
    },
    {
      "datasource": {
        "kind": "slot",
        "measurements": [
          "tyre_pressure_kpa"
        ],
        "slot": "selectedMachine"
      },
      "id": "sp-tyre",
      "layout": {
        "base": {
          "col": 9,
          "cols": 3,
          "mode": "grid",
          "row": 5,
          "rows": 3
        }
      },
      "options": {
        "flashOnChange": true,
        "max": 1000,
        "measurement": "tyre_pressure_kpa",
        "min": 0,
        "thresholds": [
          {
            "level": "major",
            "value": 0
          },
          {
            "level": "normal",
            "value": 600
          }
        ],
        "title": "Tyre pressure",
        "unit": "kPa"
      },
      "type": "gauge"
    },
    {
      "datasource": {
        "kind": "slot",
        "measurements": [
          "fuel_pct",
          "engine_temp_c",
          "payload_t",
          "tyre_pressure_kpa"
        ],
        "slot": "site"
      },
      "id": "sp-fleet",
      "layout": {
        "base": {
          "col": 0,
          "cols": 8,
          "mode": "grid",
          "row": 8,
          "rows": 5
        }
      },
      "options": {
        "ageLagSeconds": 30,
        "columns": [
          {
            "label": "Fuel",
            "measurement": "fuel_pct",
            "precision": 1,
            "unit": "%"
          },
          {
            "label": "Engine",
            "measurement": "engine_temp_c",
            "precision": 1,
            "unit": "°C"
          },
          {
            "label": "Payload",
            "measurement": "payload_t",
            "precision": 1,
            "unit": "t"
          },
          {
            "label": "Tyres",
            "measurement": "tyre_pressure_kpa",
            "precision": 1,
            "unit": "kPa"
          }
        ],
        "pageSize": 20,
        "selectionTarget": "selectedMachine",
        "sortBy": "fuel_pct",
        "sortDescending": false,
        "thresholds": [
          {
            "level": "major",
            "measurement": "fuel_pct",
            "value": 0
          },
          {
            "level": "normal",
            "measurement": "fuel_pct",
            "value": 15
          },
          {
            "level": "normal",
            "measurement": "engine_temp_c",
            "value": 0
          },
          {
            "level": "critical",
            "measurement": "engine_temp_c",
            "value": 105
          },
          {
            "level": "major",
            "measurement": "tyre_pressure_kpa",
            "value": 0
          },
          {
            "level": "normal",
            "measurement": "tyre_pressure_kpa",
            "value": 600
          }
        ],
        "title": "Fleet"
      },
      "type": "fleet-table"
    },
    {
      "datasource": {
        "kind": "slot",
        "measurements": [
          "engine_temp_c"
        ],
        "slot": "selectedMachine"
      },
      "id": "sp-engine-trend",
      "layout": {
        "base": {
          "col": 8,
          "cols": 4,
          "mode": "grid",
          "row": 8,
          "rows": 5
        }
      },
      "options": {
        "markAlarms": true,
        "markAlarmsScope": "series",
        "markCommands": true,
        "max": 130,
        "min": 60,
        "thresholds": [
          {
            "level": "critical",
            "value": 105
          }
        ],
        "title": "Engine temp history",
        "unit": "°C"
      },
      "type": "timeseries-chart"
    }
  ]
}
