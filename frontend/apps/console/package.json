{
  "name": "@devicechain/console",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "predev": "node ../../scripts/build-packages.mjs",
    "dev": "vite",
    "prebuild": "node ../../scripts/build-packages.mjs",
    "build": "tsc --noEmit && vite build && node scripts/check-bundle-size.mjs",
    "preview": "vite preview",
    "pretypecheck": "node ../../scripts/build-packages.mjs",
    "typecheck": "tsc --noEmit",
    "pretest": "node ../../scripts/build-packages.mjs",
    "test": "vitest run",
    "pretest:layout": "node ../../scripts/build-packages.mjs",
    "test:layout": "playwright test",
    "codegen": "graphql-codegen --config codegen.ts",
    "i18n:extract": "i18next -c i18next-parser.config.js",
    "lint": "eslint \"src/**/*.{ts,tsx}\""
  },
  "dependencies": {
    "@devicechain/brand": "0.0.0-dev",
    "@devicechain/client": "0.0.0-dev",
    "@devicechain/dashboards": "0.0.0-dev",
    "@devicechain/host-widgets": "0.0.0-dev",
    "@devicechain/widget-sdk": "0.0.0-dev",
    "@devicechain/widgets": "0.0.0-dev",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/inter": "^5.3.0",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-radio-group": "^1.5.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@xyflow/react": "^12.12.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "echarts": "^6.0.0",
    "graphql": "^17.0.2",
    "i18next": "^26.5.6",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^1.61.0",
    "maplibre-gl": "^6.15.0",
    "react": "^19.3.1",
    "react-colorful": "^5.8.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.3",
    "react-router-dom": "^7.18.4",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@babel/core": "^8.0.7",
    "@babel/eslint-parser": "^8.0.7",
    "@babel/preset-react": "^8.0.1",
    "@babel/preset-typescript": "^8.0.7",
    "@graphql-codegen/cli": "^7.4.6",
    "@graphql-codegen/client-preset": "^6.1.3",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-i18next": "^6.1.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "i18next-parser": "^9.4.0",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.0.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
