{
  "canvas": {
    "breakpoints": {
      "base": 0
    },
    "grid": {
      "columns": 24,
      "gap": 8,
      "rowHeight": 40
    },
    "sizing": "fill"
  },
  "schemaVersion": 1,
  "slots": {
    "focus": {
      "label": "Featured device",
      "type": "device"
    }
  },
  "title": "Fleet overview",
  "widgets": [
    {
      "id": "w-title",
      "layout": {
        "base": {
          "col": 0,
          "colSpan": 24,
          "row": 0,
          "rowSpan": 2,
          "z": 0
        }
      },
      "options": {
        "align": "left",
        "fontSize": 20,
        "text": "Fleet overview"
      },
      "type": "label"
    },
    {
      "id": "w-crit",
      "layout": {
        "base": {
          "col": 0,
          "colSpan": 6,
          "row": 2,
          "rowSpan": 4,
          "z": 0
        }
      },
      "options": {
        "severity": "CRITICAL",
        "state": "ACTIVE",
        "title": "Critical"
      },
      "type": "alarm-count"
    },
    {
      "id": "w-major",
      "layout": {
        "base": {
          "col": 6,
          "colSpan": 6,
          "row": 2,
          "rowSpan": 4,
          "z": 0
        }
      },
      "options": {
        "severity": "MAJOR",
        "state": "ACTIVE",
        "title": "Major"
      },
      "type": "alarm-count"
    },
    {
      "id": "w-minor",
      "layout": {
        "base": {
          "col": 12,
          "colSpan": 6,
          "row": 2,
          "rowSpan": 4,
          "z": 0
        }
      },
      "options": {
        "severity": "MINOR",
        "state": "ACTIVE",
        "title": "Minor"
      },
      "type": "alarm-count"
    },
    {
      "id": "w-warn",
      "layout": {
        "base": {
          "col": 18,
          "colSpan": 6,
          "row": 2,
          "rowSpan": 4,
          "z": 0
        }
      },
      "options": {
        "severity": "WARNING",
        "state": "ACTIVE",
        "title": "Warning"
      },
      "type": "alarm-count"
    },
    {
      "id": "w-alarms",
      "layout": {
        "base": {
          "col": 0,
          "colSpan": 14,
          "row": 6,
          "rowSpan": 10,
          "z": 0
        }
      },
      "options": {
        "maxRows": 50,
        "selectionTarget": "focus",
        "state": "ACTIVE",
        "title": "Active alarms - select one to focus"
      },
      "type": "alarm-table"
    },
    {
      "datasource": {
        "kind": "slot",
        "measurements": [
          "temperature"
        ],
        "slot": "focus"
      },
      "id": "w-focus-chart",
      "layout": {
        "base": {
          "col": 14,
          "colSpan": 10,
          "row": 6,
          "rowSpan": 6,
          "z": 0
        }
      },
      "options": {
        "title": "Featured device",
        "window": 300
      },
      "type": "timeseries-chart"
    },
    {
      "datasource": {
        "kind": "slot",
        "location": {
          "series": "latest"
        },
        "measurements": [],
        "slot": "focus"
      },
      "id": "w-focus-map",
      "layout": {
        "base": {
          "col": 14,
          "colSpan": 10,
          "row": 12,
          "rowSpan": 4,
          "z": 0
        }
      },
      "options": {
        "title": "Where it is"
      },
      "type": "map"
    }
  ]
}
