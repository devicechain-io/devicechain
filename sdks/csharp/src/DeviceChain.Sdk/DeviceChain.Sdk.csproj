<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- netstandard2.1 is Unity's IL2CPP-consumable target; net8.0 for standalone .NET
         hosts + the test project. The same source-gen JSON works on both. -->
    <TargetFrameworks>netstandard2.1;net8.0</TargetFrameworks>
    <RootNamespace>DeviceChain.Sdk</RootNamespace>
    <AssemblyName>DeviceChain.Sdk</AssemblyName>
    <PackageId>DeviceChain.Sdk</PackageId>
    <!-- Renders on nuget.org, so it is written for a reader who has never seen this
         repository: no ADR citations, nothing they cannot follow. Guarded by
         hack/check-docs-adr-refs.sh. -->
    <Description>DeviceChain .NET client SDK — auth, GraphQL, live subscriptions, MQTT device-plane telemetry and commands. AOT/IL2CPP-safe, for .NET and Unity.</Description>
    <Authors>The DeviceChain Authors</Authors>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <Copyright>Copyright The DeviceChain Authors</Copyright>
    <PackageProjectUrl>https://devicechain.io</PackageProjectUrl>
    <RepositoryUrl>https://github.com/devicechain-io/devicechain</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <!-- Renders on nuget.org, same rule as Description: no ADR citations. -->
    <PackageTags>iot;iiot;devicechain;mqtt;graphql;telemetry;unity;device-management</PackageTags>

    <!-- 🔴 PACKAGE.md, not the repository README. ../../README.md is written for
         someone reading this repo and cites ADRs freely; a PackageReadmeFile is
         rendered as the package's body on nuget.org, which puts it under the same
         "no ADR references in published prose" rule as Description/PackageTags.
         Keeping them as two files is what lets each one be right for its reader.
         hack/check-docs-adr-refs.sh follows this property to whatever file it
         names, so pointing it back at ../../README.md fails the docs CI job.

         The property names the file by its REAL name rather than packing it as
         README.md, which is the more common .NET convention. Deliberate: the
         guard resolves this property literally, so a rename-on-pack would send
         it looking for a file that does not exist, find nothing, and report
         clean — a guard that cannot fire. NuGet renders whatever name it is
         given; the convention buys nothing that is worth that. -->
    <PackageReadmeFile>PACKAGE.md</PackageReadmeFile>

    <!-- The brand avatar, not the wordmark lockup. Measured, not eyeballed: this
         file is fully opaque (alpha 255 everywhere, on #0b1620), so it renders the
         same against nuget.org's light and dark themes and against Visual Studio's.
         branding/logos/devicechain_700x700-style lockups are transparent-cornered
         with dark text, which disappears on a dark background — and their wordmark
         is illegible at the ~32px NuGet uses in search results, where this mark
         still reads. -->
    <PackageIcon>avatar-400.png</PackageIcon>

    <!-- The VERSION IS THE RELEASE TAG, exactly as it is for the images and the
         Helm chart: release.yml derives it from the pushed tag and passes
         -p:Version=, with the tag's leading 'v' stripped as the chart already
         does (NuGet rejects 'v0.13.0' outright, so that one cannot ship wrong
         — it just costs a release run). Nothing here is bumped by hand, and no
         release number is
         committed to a file — the repo has deliberately never had one (the root
         VERSION file is 0.0.1 and is not what any release reads).

         This default is therefore not "the current version", it is what a pack
         that FORGOT to pass one produces, and it is chosen to be unmistakable.
         The .NET SDK's own default is 1.0.0 — a number that reads as a shipped
         1.0 release. nuget.org versions are IMMUTABLE and cannot be reused after
         a delete, so an accidental push of that default would permanently burn
         this package's 1.0.0 on a dev build. 0.0.0-dev burns nothing anyone
         wants. Verified by packing: with no -p:Version the SDK really did emit
         DeviceChain.Sdk.1.0.0.nupkg. -->
    <Version>0.0.0-dev</Version>

    <!-- Ship debuggable symbols alongside the package. A client SDK is code its
         consumers step INTO when a call misbehaves against their own server, and
         without this that stack stops at the assembly boundary. snupkg is the
         format nuget.org's symbol server accepts, so the publish pushes two files.

         EmbedUntrackedSources earns its place here specifically: the JSON
         serializers are SOURCE-GENERATED, so they exist in no commit and a
         debugger cannot fetch them from GitHub the way it fetches the rest.
         Embedding puts them in the symbols instead of leaving the one part of
         the library a consumer is most likely to be debugging as a blank. -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <!-- Flag AOT-incompatible patterns at build on the net8.0 target (the analyzer that
       backs the Unity IL2CPP guarantee). -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <!-- Packed from the repository's single brand-asset directory rather than a copy
         beside this csproj: one file, so the icon cannot drift away from the logo it
         is derived from. A wrong path cannot ship silently — measured: `dotnet pack`
         fails with NU5019 when this Include misses (and NU5046 when <PackageIcon>
         names something the package does not contain) — and CI packs, so it fails
         there rather than at release. -->
    <None Include="$(MSBuildThisFileDirectory)../../../../branding/logos/avatar-400.png"
          Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <!-- The nuget.org-facing readme, packed at the package root under its own name.
         Named PACKAGE.md, not README.md, so that a glance at this directory cannot
         confuse it with the repository README one level up — they are written for
         different readers and only one of them may cite ADRs. -->
    <None Include="PACKAGE.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <!-- System.Text.Json is in-box on net8.0; referenced explicitly so the netstandard2.1
         target (Unity) gets the same source-generator + API surface. -->
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
    <!-- Channels backs the subscribe stream's per-operation buffering (AOT-safe, no codegen). -->
    <PackageReference Include="System.Threading.Channels" Version="8.0.0" />
    <!-- MQTT device plane (publish telemetry + receive commands). PINNED TO THE 4.x LINE ON
         PURPOSE: MQTTnet 5 targets net8.0/net10.0 only, having dropped netstandard2.1 — the
         target Unity/IL2CPP consumes — so "upgrade to 5" would silently delete the Unity half
         of this SDK. 4.3.7 has ZERO transitive dependencies on both our targets, so it stages
         into a Unity project as a single DLL, and carries no reflection, which is what keeps
         the AOT guarantee intact. See Transport/MqttNetConnection.cs. -->
    <PackageReference Include="MQTTnet" Version="4.3.7.1207" />
  </ItemGroup>

  <ItemGroup>
    <!-- The pinned-root TLS decision is internal but must be directly testable: it is the only
         security decision the SDK makes on its own, it is hand-built because the one-line API is
         missing on netstandard2.1, and a live TLS handshake was otherwise its only exerciser. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>DeviceChain.Sdk.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
