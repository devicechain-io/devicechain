      "profileToken": "sp-equipment-profile",
      "enabled": true,
      "alarmSeverityWire": "MAJOR",
      "definition": "{\"actions\":[{\"raiseAlarm\":{\"alarmKey\":\"low-fuel\"},\"type\":\"raiseAlarm\"},{\"sendCommand\":{\"command\":\"goto-refuel\",\"expiresAfter\":\"15m\"},\"type\":\"sendCommand\"}],\"name\":\"Site Pulse low fuel\",\"severity\":\"major\",\"type\":\"threshold\",\"when\":{\"metric\":\"fuel_pct\",\"op\":\"lt\",\"threshold\":15}}"
    },
    {
      "producer": "sitepulse",
