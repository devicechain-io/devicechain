{
  "name": "@devicechain/board-replay",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "predev": "node ../../scripts/build-packages.mjs",
    "dev": "vite",
    "prebuild": "node ../../scripts/build-packages.mjs",
    "build": "tsc --noEmit && vite build && node scripts/check-bundle-size.mjs",
    "preview": "vite preview",
    "pretypecheck": "node ../../scripts/build-packages.mjs",
    "typecheck": "tsc --noEmit",
    "pretest": "node ../../scripts/build-packages.mjs",
    "test": "vitest run",
    "pretest:readability": "node ../../scripts/build-packages.mjs",
    "test:readability": "playwright test",
    "pretest:csp": "node ../../scripts/build-packages.mjs",
    "test:csp": "vite build && playwright test -c playwright.csp.config.ts",
    "lint": "eslint \"src/**/*.{ts,tsx}\""
  },
  "dependencies": {
    "@devicechain/brand": "0.0.0-dev",
    "@devicechain/client": "0.0.0-dev",
    "@devicechain/dashboards": "0.0.0-dev",
    "@devicechain/host-widgets": "0.0.0-dev",
    "@devicechain/widget-sdk": "0.0.0-dev",
    "@devicechain/widgets": "0.0.0-dev",
    "echarts": "^6.0.0",
    "i18next": "^27.2.5",
    "maplibre-gl": "^6.19.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^18.0.3"
  },
  "devDependencies": {
    "@babel/core": "^8.1.2",
    "@babel/eslint-parser": "^8.1.2",
    "@babel/preset-react": "^8.0.1",
    "@babel/preset-typescript": "^8.0.7",
    "@fontsource-variable/inter": "5.3.0",
    "@playwright/test": "1.65.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-i18next": "^6.1.5",
    "jsdom": "^31.0.1",
    "typescript": "~7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
