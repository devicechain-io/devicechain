# Copy to terraform.tfvars (which git ignores) and fill in.
project_id = "my-project"

# location              = "us-east4-b"
# cluster_name          = "devicechain"
# database_machine_type = "n2-standard-4"    # memory: Postgres leans on the page cache
# database_node_count   = 3
# services_machine_type = "t2d-standard-4"  # 4 vCPU (4 physical cores), 16 GB: CPU first. T2D is not in every zone;
#                                           # fallback "n2d-custom-4-8192". See the README
# services_node_count   = 3
# database_disk_type    = "pd-standard"      # boot disks: pd-standard stays out of SSD_TOTAL_GB,
# services_disk_type    = "pd-standard"      # which the volumes need; set before the first apply
# loadgen_node_count    = 1
