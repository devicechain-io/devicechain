{
  "rules": [
    {
      "producer": "buildingpulse",
      "ruleToken": "bp-over-temp",
      "profileToken": "bp-thermostat-profile",
      "enabled": true,
      "alarmSeverityWire": "MAJOR",
      "definition": "{\"actions\":[{\"raiseAlarm\":{\"alarmKey\":\"bp-over-temp\"},\"type\":\"raiseAlarm\"}],\"name\":\"Building Pulse over-temperature\",\"severity\":\"major\",\"type\":\"threshold\",\"when\":{\"metric\":\"temperature\",\"op\":\"gt\",\"threshold\":30}}"
    },
    {
      "producer": "loadtest",
      "ruleToken": "harness-cmd-overtemp",
      "profileToken": "harness-cmd-profile",
      "enabled": true,
      "alarmSeverityWire": "",
      "definition": "{\"actions\":[{\"sendCommand\":{\"command\":\"harness-reset\"},\"type\":\"sendCommand\"}],\"name\":\"Load-test command harness over-temp\",\"type\":\"threshold\",\"when\":{\"metric\":\"temp\",\"op\":\"gt\",\"threshold\":30}}"
    },
    {
      "producer": "loadtest",
      "ruleToken": "harness-overtemp",
      "profileToken": "harness-profile",
      "enabled": true,
      "alarmSeverityWire": "MAJOR",
      "definition": "{\"actions\":[{\"raiseAlarm\":{\"alarmKey\":\"harness-overtemp\"},\"type\":\"raiseAlarm\"}],\"name\":\"Load-test harness over-temp\",\"severity\":\"major\",\"type\":\"threshold\",\"when\":{\"metric\":\"temp\",\"op\":\"gt\",\"threshold\":30}}"
    },
    {
