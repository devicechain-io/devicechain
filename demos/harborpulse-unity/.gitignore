# Unity-generated and machine-local state. Everything here is rebuilt by the
# Editor on open, or belongs to one person's machine.
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Bb]uilds/
/[Mm]emory[Cc]aptures/
/[Rr]ecordings/

# IDE and generated project files
.vs/
.vscode/
.idea/
*.csproj
!/Dotnet~/**/*.csproj
*.sln
*.slnx
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Crash reports and dumps
sysinfo.txt
crashlytics-build.properties
*.dmp
mono_crash.*

# Scratch editor scripts used while driving the Editor from the command line
/EditorScratch/
/EditorScratch.meta


# Player builds
/Build/


# Stills rendered by Harborpulse > Render Preview Stills
/Stills/

# The Dotnet~ sidecar's solution is source, unlike the Editor-generated ones at the root
!/Dotnet~/*.sln
