          "rows": 3
        }
      },
      "options": {
        "title": "Ring",
        "min": 0,
        "max": 100
      },
      "datasource": {
        "kind": "device",
        "deviceToken": "gate-fuelless",
        "measurements": [
          "fuel_level"
        ]
      }
    }
  ],
  "slots": {
    "pick": {
      "label": "Device",
      "type": "device"
    }
  }
}
