  "title": "DeviceChain — Command Delivery",
  "uid": "dc-command-delivery-ops",
  "description": "Operations board for command delivery: fleet writes (batch enqueues, device dispositions, refusal codes and whether the delivery-machinery reserve caused them, cancels), the dispatch sweep's claim outcomes, and the presence gate's holds. The instance picker is driven by claims_lost rather than by a batch counter, because the batch counters are label vectors that export nothing until the first fleet write — picking one of those would leave the dashboard unable to name an instance that has only ever sent single commands. Note the two naming eras: the six original counters carry a historical command_delivery_ stutter in their metric names and the batch counters do not.",
  "version": 1,
  "weekStart": "",
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Fleet writes",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Batches created /s",
      "description": "Fleet writes admitted and persisted — a new batch, not an idempotent replay.",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(devicechain_commanddelivery_batch_enqueues_total{namespace=\"$namespace\", outcome=\"created\"}[5m]))",
          "legendFormat": "__auto"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "auto"
      }
    },
