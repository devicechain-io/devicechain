          "col": 0,
          "colSpan": 8,
          "row": 0,
          "rowSpan": 2,
          "z": 0
        }
      },
      "options": {
        "align": "left",
        "fontSize": 14,
        "text": "Fits"
      }
    },
    {
      "id": "nc-overflowing-card",
      "type": "latest-card",
      "layout": {
        "base": {
          "col": 8,
          "colSpan": 1,
          "row": 0,
          "rowSpan": 3,
          "z": 0
        }
      },
      "datasource": {
        "kind": "device",
        "deviceToken": "gate-device-01",
