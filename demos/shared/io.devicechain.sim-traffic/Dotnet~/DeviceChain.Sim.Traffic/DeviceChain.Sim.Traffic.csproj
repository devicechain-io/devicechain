  The runtime assembly, compiled from the package's Runtime/ folder (the same files Unity
  compiles through DeviceChain.Sim.Traffic.asmdef, which has no engine references).
-->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.1;net8.0</TargetFrameworks>
    <RootNamespace>DeviceChain.Sim.Traffic</RootNamespace>
    <AssemblyName>DeviceChain.Sim.Traffic</AssemblyName>
  </PropertyGroup>

  <!-- The trim and AOT analyzers only run on a target that supports them. The library must
       stay free of reflection and runtime code generation, since Unity players run it under
       IL2CPP. -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <!-- Pinned on purpose. IsAotCompatible/PublishAot make the SDK add Microsoft.NET.ILLink.Tasks
       implicitly, at the version bundled with whichever .NET SDK patch is installed. That floats
       with the runner image, so a locked restore fails NU1004 the day the image moves a patch.
       Declared here, the version is ours and moves only when this line (and the lock) does. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="Microsoft.NET.ILLink.Tasks" Version="8.0.31" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../../Runtime/**/*.cs" />
  </ItemGroup>

</Project>
