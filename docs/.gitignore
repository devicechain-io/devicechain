# Docusaurus
/.docusaurus/
/build/
/node_modules/

# Generated
.cache-loader

# The published GraphQL schemas, written by scripts/generate-schema.mjs on every
# start and build. Never committed: a copy in the tree is a copy that can drift
# from the schemas the services actually parse, and the whole point of generating
# them is that it cannot.
/static/schema/

# The GraphQL reference pages, written by scripts/generate-graphql-reference.mjs on
# every start and build from the same SDL — never committed, for the same reason.
/generated/
/i18n/*/docusaurus-plugin-content-docs-graphql-reference/

# The user-guide screenshots, fetched at the commit in guide-assets.lock by
# scripts/fetch-guide-assets.mjs on every start and build. They live in the
# devicechain-io/guide-assets repository, never here.
/static/img/guide/
