  "wireVocabulary": {
    "alarmState": {
      "active": "ACTIVE",
      "cleared": "CLEARED"
    },
    "commandStatus": {
      "queued": "QUEUED",
      "sent": "SENT",
      "successful": "SUCCESSFUL"
    },
    "detectionRuleStatus": {
      "active": "ACTIVE"
    }
  }
