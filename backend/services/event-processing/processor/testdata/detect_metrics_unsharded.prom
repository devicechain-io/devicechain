# HELP devicechain_eventprocessing_detect_rules_active Rules loaded into the DETECT engine.
# TYPE devicechain_eventprocessing_detect_rules_active gauge
devicechain_eventprocessing_detect_rules_active 0
# HELP devicechain_eventprocessing_detect_shard_busy_seconds_total Seconds each detection shard has spent applying operations. The rate is the shard's utilisation; one shard far above the others is a hot key, all of them near 1 means detectShards is the limit.
# TYPE devicechain_eventprocessing_detect_shard_busy_seconds_total counter
devicechain_eventprocessing_detect_shard_busy_seconds_total{shard="0"} 0
devicechain_eventprocessing_detect_shard_busy_seconds_total{shard="1"} 0
# HELP devicechain_eventprocessing_detect_shard_invariant_violations_total Times the detection shards disagreed on the watermark or the position at a snapshot, or with the loop on the position. The snapshot is refused. Any increase is a defect.
# TYPE devicechain_eventprocessing_detect_shard_invariant_violations_total counter
devicechain_eventprocessing_detect_shard_invariant_violations_total 0
# HELP devicechain_eventprocessing_detect_shard_live_keys Live windows, timers and latches each detection shard holds, sampled on the state-budget tick. An uneven spread is key skew.
# TYPE devicechain_eventprocessing_detect_shard_live_keys gauge
devicechain_eventprocessing_detect_shard_live_keys{shard="0"} 0
devicechain_eventprocessing_detect_shard_live_keys{shard="1"} 0
# HELP devicechain_eventprocessing_detect_shard_queue_depth Operations queued for each detection shard, sampled on the loop's tick. A queue that stays near its bound means that shard is the slowest and the loop is waiting on it.
# TYPE devicechain_eventprocessing_detect_shard_queue_depth gauge
devicechain_eventprocessing_detect_shard_queue_depth{shard="0"} 0
devicechain_eventprocessing_detect_shard_queue_depth{shard="1"} 0
# HELP devicechain_eventprocessing_detect_shards How many ways the live detection engine's keyed state is split (the detectShards setting; 1 is the unsplit engine). Set when the engine is built or restored.
# TYPE devicechain_eventprocessing_detect_shards gauge
devicechain_eventprocessing_detect_shards 0
# HELP devicechain_eventprocessing_detect_snapshot_bytes Serialized size of the last DETECT snapshot payload.
# TYPE devicechain_eventprocessing_detect_snapshot_bytes gauge
devicechain_eventprocessing_detect_snapshot_bytes 0
