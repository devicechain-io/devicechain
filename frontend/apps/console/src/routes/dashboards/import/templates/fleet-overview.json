{
  "canvas": {
    "breakpoints": {
      "base": 0
    },
    "grid": {
      "columns": 12,
      "gutter": 8,
      "minCellSize": 56,
      "padding": 0
    },
    "sizing": "fill"
  },
  "schemaVersion": 3,
  "slots": {
    "focus": {
      "label": "Featured device",
      "type": "device"
    }
  },
  "title": "Fleet overview",
  "widgets": [
    {
      "id": "w-title",
      "layout": {
        "base": {
          "col": 0,
          "cols": 12,
          "mode": "grid",
          "row": 0,
          "rows": 1
        }
      },
      "options": {
        "align": "left",
        "fontSize": 20,
        "text": "Fleet overview"
      },
      "type": "label"
    },
    {
      "id": "w-crit",
      "layout": {
        "base": {
          "col": 0,
          "cols": 3,
          "mode": "grid",
          "row": 1,
          "rows": 2
        }
      },
      "options": {
        "severity": "CRITICAL",
        "state": "ACTIVE",
        "title": "Critical"
      },
      "type": "alarm-count"
    },
    {
      "id": "w-major",
      "layout": {
        "base": {
          "col": 3,
          "cols": 3,
          "mode": "grid",
          "row": 1,
          "rows": 2
        }
      },
      "options": {
        "severity": "MAJOR",
        "state": "ACTIVE",
        "title": "Major"
      },
      "type": "alarm-count"
    },
    {
      "id": "w-minor",
      "layout": {
        "base": {
          "col": 6,
          "cols": 3,
          "mode": "grid",
          "row": 1,
          "rows": 2
        }
      },
      "options": {
        "severity": "MINOR",
        "state": "ACTIVE",
        "title": "Minor"
      },
      "type": "alarm-count"
    },
    {
      "id": "w-warn",
      "layout": {
        "base": {
          "col": 9,
          "cols": 3,
          "mode": "grid",
          "row": 1,
          "rows": 2
        }
      },
      "options": {
        "severity": "WARNING",
        "state": "ACTIVE",
        "title": "Warning"
      },
      "type": "alarm-count"
    },
    {
      "id": "w-alarms",
      "layout": {
        "base": {
          "col": 0,
          "cols": 7,
          "mode": "grid",
          "row": 3,
          "rows": 5
        }
      },
      "options": {
        "maxRows": 50,
        "selectionTarget": "focus",
        "state": "ACTIVE",
        "title": "Active alarms - select one to focus"
      },
      "type": "alarm-table"
    },
    {
      "datasource": {
        "kind": "slot",
        "measurements": [
          "temperature"
        ],
        "slot": "focus"
      },
      "id": "w-focus-chart",
      "layout": {
        "base": {
          "col": 7,
          "cols": 5,
          "mode": "grid",
          "row": 3,
          "rows": 3
        }
      },
      "options": {
        "title": "Featured device"
      },
      "type": "timeseries-chart"
    },
    {
      "datasource": {
        "kind": "slot",
        "location": {
          "series": "latest"
        },
        "measurements": [],
        "slot": "focus"
      },
      "id": "w-focus-map",
      "layout": {
        "base": {
          "col": 7,
          "cols": 5,
          "mode": "grid",
          "row": 6,
          "rows": 3
        }
      },
      "options": {
        "title": "Where it is"
      },
      "type": "map"
    }
  ]
}
