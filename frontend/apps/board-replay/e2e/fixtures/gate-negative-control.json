    {
      "id": "nc-overlap-b",
      "type": "label",
      "layout": {
        "base": {
          "col": 18,
          "colSpan": 6,
          "row": 0,
          "rowSpan": 2,
          "z": 0,
          "offset": {
            "x": -80,
            "y": 16
          }
        }
      },
      "options": {
        "align": "left",
        "fontSize": 14,
        "text": "B"
      }
